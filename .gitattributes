# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare files that always use LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.py    text eol=lf
*.dart  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.toml  text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sql   text eol=lf
*.sh    text eol=lf

# Windows-only files use CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.pdf   binary
*.mp4   binary
*.mp3   binary
*.ttf   binary
*.woff  binary
*.woff2 binary
