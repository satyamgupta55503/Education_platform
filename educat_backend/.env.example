# ════════════════════════════════════════════════════════════════
# EduCat AI Backend — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────
APP_NAME="EduCat AI Backend"
APP_VERSION="3.0.0"
ENVIRONMENT=development      # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # NEVER expose
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ── JWT (RS256) ───────────────────────────────────────────────────
# Generate: openssl genrsa -out private.pem 4096 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEo...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjAN...\n-----END PUBLIC KEY-----"
JWT_ALGORITHM=RS256

# ── Firebase ─────────────────────────────────────────────────────
# Generate: base64 -i serviceAccountKey.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON=BASE64_ENCODED_SERVICE_ACCOUNT_JSON
FIREBASE_PROJECT_ID=educat-ai-prod

# ── Google OAuth2 (Teacher/School Login) ─────────────────────────
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=https://teacher.educat.ai/auth/callback

# ── Gemini AI ─────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...    # NEVER expose to any frontend
GEMINI_MODEL_FREE=gemini-2.0-flash-lite
GEMINI_MODEL_PAID=gemini-2.5-flash
GEMINI_EMBED_MODEL=models/text-embedding-004

# ── Google Cloud (TTS/STT/Vision) ────────────────────────────────
GOOGLE_CLOUD_PROJECT_ID=educat-ai-prod
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Security ─────────────────────────────────────────────────────
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=YOUR_FERNET_KEY_HERE
TOTP_ISSUER_NAME="EduCat School"
MAX_OTP_ATTEMPTS=3
LOCKOUT_MINUTES=15

# ── Razorpay ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...    # Use rzp_live_ in production
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ── Celery ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Semantic Cache ────────────────────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD_DEFAULT=0.92
SEMANTIC_CACHE_TTL_DAYS=30

# ── Token Quotas ─────────────────────────────────────────────────
TOKEN_QUOTA_FREE=25
TOKEN_QUOTA_SMART=250
TOKEN_QUOTA_GENIUS=600
TOKEN_DAILY_CAP_FREE=2
TOKEN_DAILY_CAP_SMART=15
TOKEN_DAILY_CAP_GENIUS=30

# ── Monitoring ───────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project   # optional
